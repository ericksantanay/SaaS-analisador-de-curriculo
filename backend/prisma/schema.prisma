generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model usuarios {
    id                String  @id @default(auto()) @map("_id") @db.ObjectId
    nome              String
    email             String  @unique
    senha             String
    emailVerificado   Boolean @default(false)
    codigoVerificacao String?
    role              String
    analises          Int @default(3)
    historico         Boolean @default(false)
    plano             String

    pesquisa          promptsCurriculos[]
}

model promptsCurriculos {
    id                String  @id @default(auto()) @map("_id") @db.ObjectId
    prompt            String
    pdfCurriculo      String    

    userId            String   @db.ObjectId
    usuario           usuarios @relation(fields: [userId], references: [id])
}